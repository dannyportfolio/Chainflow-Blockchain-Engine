# ChainFlow Environment Configuration Template (Testnet / Local Only)
# Copy to .env for local development. Never commit real credentials or private keys.

CHAINFLOW_ENV=development
CHAINFLOW_LOG_LEVEL=info

# HTTP API
CHAINFLOW_HTTP_ADDR=:8080
CHAINFLOW_HTTP_READ_TIMEOUT=5s
CHAINFLOW_HTTP_WRITE_TIMEOUT=10s
CHAINFLOW_HTTP_SHUTDOWN_TIMEOUT=25s

# PostgreSQL
CHAINFLOW_DB_DSN=postgres://chainflow:chainflow@localhost:5432/chainflow?sslmode=disable
CHAINFLOW_DB_MAX_CONNS=25
CHAINFLOW_DB_MIN_CONNS=5

# NATS JetStream
CHAINFLOW_NATS_URL=nats://localhost:4222
CHAINFLOW_NATS_STREAM=CHAINFLOW_TX
CHAINFLOW_NATS_ACK_WAIT=45s
CHAINFLOW_NATS_MAX_DELIVER=5

# Worker Pool & Leases
CHAINFLOW_WORKER_CONCURRENCY=20
CHAINFLOW_WORKER_LEASE_TTL=30s

# EVM Chain (Sepolia testnet default: 11155111)
CHAINFLOW_CHAIN_ID=11155111
CHAINFLOW_REQUIRED_CONFIRMATIONS=6
CHAINFLOW_MAX_FEE_CAP_WEI=100000000000
CHAINFLOW_RPC_URLS=http://localhost:8545

# Auth (comma-separated tenant:sha256hex[:0xAllowedSender])
CHAINFLOW_API_KEYS=
CHAINFLOW_RATE_LIMIT_RPS=50
CHAINFLOW_RATE_LIMIT_BURST=100
